# DeepSeek（优先）：OpenAI 兼容接口
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-flash"

# Kimi（规划/次选）：Moonshot OpenAI 兼容接口
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.cn/v1"
KIMI_MODEL="kimi-k2.7-code"

# 说明：
# 1. Gemini 兜底默认不启用；如需启用，请在云平台环境变量中自行添加 GEMINI_API_KEY。
# 2. 云平台会自动注入 PORT，无需配置；NODE_ENV 在平台中设为 production。
